{
  "name": "clicky",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @clicky/db generate",
    "db:migrate": "pnpm --filter @clicky/db migrate",
    "db:seed": "pnpm --filter @clicky/web seed",
    "db:seed-analytics": "pnpm --filter @clicky/web seed:analytics"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
