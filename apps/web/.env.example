# Copy to .env.local for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clicky
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: lets the knowledge crawler read sites on localhost (e.g. the demo app help pages).
# CLICKY_ALLOW_PRIVATE_FETCH=1

# Assistant. Without ANTHROPIC_API_KEY a local stand-in answers (good for development, not real use).
ANTHROPIC_API_KEY=
# CLICKY_ASSISTANT_MODEL=claude-opus-5-5
# CLICKY_ASSISTANT_PROVIDER=stub   # force the stand-in even with a key

# Voice. Without these, the browser's built-in speech recognition and voices are used.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Billing (Stripe). Without these, the Billing page shows plans and, outside production, a dev plan switcher.
# CLICKY_DEV_BILLING=1   # show the dev plan switcher in a production build too (testing only; ignored once Stripe is set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=

# Email (Resend). Without a key, emails (magic links, invites) are printed to the server log.
RESEND_API_KEY=
# EMAIL_FROM=Clicky <hello@yourdomain.com>

# Daily data-retention job (/api/cron/retention, scheduled in vercel.json). Vercel Cron sends this as a Bearer token.
CRON_SECRET=
